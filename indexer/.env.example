# Dummy values so `ENV_FILE=.env.example pnpm prepare:env` can render
# subgraph.yaml for codegen and tests. Real addresses live in
# config/<env>.env and are only needed at deploy time.

# ── Subgraph manifest ──────────────────────────────────────────────────────
NETWORK=base-sepolia
PERPS_ADDRESS=0x0000000000000000000000000000000000000000
PERPS_START_BLOCK=0

# ── docker-compose (graph-node) ────────────────────────────────────────────
ETH_NODE_ADDRESS=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
