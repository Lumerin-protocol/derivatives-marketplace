# Subgraph Configuration
# Copy this file to .env and update values for local development
# For CI/CD deployments, these are set as environment variables

# Network name (localhost, arbitrum-sepolia, arbitrum)
NETWORK=arbitrum-sepolia

# PerpsSimple contract address
PERPS_ADDRESS=0x0000000000000000000000000000000000000000

# Block number to start indexing
START_BLOCK=0

SUBGRAPH_ETH_NODE=
