{
  "name": "perps-indexer",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6.0"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf data generated build subgraph.yaml",
    "codegen": "pnpm prepare-local && graph codegen",
    "prepare:env": "envsubst < subgraph.template.yaml > subgraph.yaml",
    "prepare-local": "set -a && source ../.env && set +a && envsubst < subgraph.template.yaml > subgraph.yaml",
    "build": "graph build",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ perps",
    "create-local": "graph create --node http://localhost:8020/ perps",
    "remove-local": "graph remove --node http://localhost:8020/ perps",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 --version-label 0 perps",
    "setup-local": "pnpm prepare-local && pnpm codegen && pnpm build && pnpm create-local && pnpm deploy-local",
    "test": "pnpm test:integration",
    "test:integration": "hardhat test nodejs",
    "test:integration:debug": "MATCHSTICK_VERBOSE=true hardhat test nodejs",
    "test:unit": "graph test",
    "indexer": "docker compose --env-file ../.env up",
    "test:smoke": "node --test tests/queries.smoke.ts",
    "graph:api": "open http://localhost:8030/graphql/playground",
    "typecheck": "tsgo --noEmit -p integration/tsconfig.json",
    "lint": "biome lint .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@graphprotocol/graph-ts": "0.37.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@graphprotocol/graph-cli": "^0.98.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.8",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.8",
    "@nomicfoundation/hardhat-viem": "^3.0.7",
    "@types/node": "^25.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "assemblyscript": "^0.19.23",
    "derivatives-contracts": "link:../contracts",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "hardhat": "^3.9.1",
    "hardhat-matchstick-ts": "github:lsheva/matchstick-ts#v0.4.2&path:packages/hardhat-matchstick-ts",
    "matchstick-as": "0.6.0",
    "matchstick-ts": "github:lsheva/matchstick-ts#v0.4.2&path:packages/matchstick-ts",
    "typescript": "^5.9.3",
    "viem": "^2.48.8"
  },
  "packageManager": "pnpm@11.22.0"
}
