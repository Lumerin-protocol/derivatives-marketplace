# Single .env file for all projects — keep keys sorted alphabetically

# Variables
BUYER2_ADDRESS=
BUYER_ADDRESS=
COLLATERAL_TOKEN_ADDRESS=
# Contract size is a compile-time constant (CONTRACT_SIZE_HPS_DAY = 1e15 = 1 PH/s over a day → 1 contract = 1 PH/s/day); not configurable.
DEFAULT_OPTIONS_SERIES_ID=
ETH_NODE_ADDRESS=
ETH_PRICE_FEED_ADDRESS=
LIQUIDATION_FEE=1000000
MAINTENANCE_MARGIN_PERCENT=5
MARGIN_PERCENT=10
# Tick size in collateral-token units. Scaled for the per-PH contract unit (10x the legacy 100 TH tick).
MINIMUM_PRICE_INCREMENT=100000
NETWORK=localhost
OPTION_MARGIN_ENGINE_ADDRESS=
OPTION_MATCHING_ROUTER_ADDRESS=
OPTION_ORDER_BOOK_ADDRESS=
OPTION_REGISTRY_ADDRESS=
OPTION_SETTLEMENT_ADDRESS=
OPTIONS_SERIES_EXPIRY_UNIX=
ORDER_FEE=1000000
OWNER_ADDRESS=
PERPS_ADDRESS=
PERPS_START_BLOCK=
PORTFOLIO_MARGIN_ENGINE_ADDRESS=
PRICE_ORACLE_ADDRESS=
SELLER2_ADDRESS=
SELLER_ADDRESS=
VAULT_ADDRESS=

# Secrets
DEPLOYER_PRIVATEKEY=
ETHERSCAN_API_KEY=
