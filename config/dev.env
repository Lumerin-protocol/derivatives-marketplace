PRICE_ORACLE_ADDRESS=0xf97a1bbfb5e061ef73dad8ebf25939d93639fb7f
VAULT_ADDRESS=0x54A79e2a5C60ACe37b280eBbCda51b4E903d25F0
PME_ADDRESS=0x3899e429Ef47140eC46c6E23F04253C24F221b69

# ── Subgraph manifests ─────────────────────────────────────────────────────
PERPS_START_BLOCK=46342657
PERPS_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmmz59uoa7b5201wthnkxbuqy/subgraphs/hpow-derivatives/dev-latest/gn

