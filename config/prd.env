# Public, per-environment values for PRD (base mainnet).
#
# Loaded by Hardhat (`--env prd`), the subgraph renderer (`ENV_FILE`),
# and the deploy workflow. GitHub environments `main` and `stg` both
# map here: they share the same contracts. Goldsky rolling tags stay
# as deploy-orchestration variables (`lmn-latest` / `stg-latest`).
#
# `base` is the Graph manifest name, the viem chain key, and the Hardhat
# network name. Hardhat still accepts the older `base-mainnet` spelling
# as a deprecated alias.
#
# Never put secrets here. Those live in the repo-root `.env` locally and in
# GitHub Secrets in CI, and both take precedence over this file.
#
# Values are unquoted on purpose: `docker run --env-file` does not strip quotes
# in every CLI version, unlike Node, bash, and Compose.

NETWORK=base

# ── Contracts ──────────────────────────────────────────────────────────────
COLLATERAL_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PERPS_ADDRESS=0x794f9e63b7666985256f1d2763ee24cc0b528199
PRICE_ORACLE_ADDRESS=0x614dCAfa33AF0705C7b4A37667eF511F400F36d0
VAULT_ADDRESS=0x0730422E49B76A2D36d51304ACEcbe4f444821F8
PME_ADDRESS=0x5F047CCE438ae7796140506a5edf3D711034aaF3
SAFE_OWNER_ADDRESS=0x63E09ead6CcF8850287370B4b248B02D4D43e1Ba
POINTS_HOOK_ADDRESS=0x81f47f6c84ffb1a5daa8c54989a4cb9458017188

# ── Subgraph manifests ─────────────────────────────────────────────────────
PERPS_START_BLOCK=43872047

# ── Deploy / upgrade parameters ────────────────────────────────────────────
# PERPS_DEPLOYMENT_BLOCK is the original proxy-creation block; it is not
# the subgraph start block. update-perps.ts requires it.
PERPS_DEPLOYMENT_BLOCK=39298170
MINIMUM_PRICE_INCREMENT=10000
TAKER_FEE_BPS=100
MAKER_FEE_BPS=0
LIQUIDATION_FEE=1000000
MAINTENANCE_MARGIN_PERCENT=5
MARGIN_PERCENT=10
ORDER_FEE=1000000
