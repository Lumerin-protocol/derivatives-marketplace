# Prefer repo-root `.env` / `.env.local` (shared with keeper, deploy, etc.).
# Generate local addresses: cd contracts && pnpm deploy-local
#
# options-ui reads only the variables declared in vite.config.ts (import.meta.env.*).

ETH_NODE_ADDRESS=http://127.0.0.1:8545
COLLATERAL_TOKEN_ADDRESS=
VAULT_ADDRESS=
OPTION_REGISTRY_ADDRESS=
OPTION_MARGIN_ENGINE_ADDRESS=
OPTION_MATCHING_ROUTER_ADDRESS=
DEFAULT_OPTIONS_SERIES_ID=1
