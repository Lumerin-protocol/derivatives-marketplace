FROM node:22-alpine

WORKDIR /app

# Install only hardhat — the node command needs nothing else.
# This avoids pulling in the full contracts dependency tree (OpenZeppelin,
# Chainlink, native EDR binaries built for macOS, etc.).
RUN corepack enable && \
    pnpm init && \
    pnpm pkg set type="module" && \
    pnpm add hardhat && \
    echo 'export default { networks: { hardhat: { blockGasLimit: 50_000_000, type: "http", url: "http://127.0.0.1:8545" } } }' > hardhat.config.ts

EXPOSE 8545

CMD ["node_modules/.bin/hardhat", "node", "--hostname", "0.0.0.0"]
